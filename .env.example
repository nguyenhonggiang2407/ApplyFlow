# Local development. Node 24+ is required.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/applyflow.sqlite
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
ENABLE_DEMO=true
# Set to 1 only when the API is behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Compiled production preview only: leave false for real deployments.
ALLOW_INSECURE_LOCAL_HTTP=false
